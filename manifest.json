{
	"manifest_version": 3,
	"default_locale": "en",

	"name": "User-Agent Switcher",
	"description": "__MSG_extension_description__",

	"version": "1.4.1",
	"homepage_url": "https://gitlab.com/ntninja/user-agent-switcher",

	"icons": {
		"16":  "assets/icons/icon-16.png",
		"32":  "assets/icons/icon-32.png",
		"48":  "assets/icons/icon-48.png",
		"128": "assets/icons/icon-128.png"
	},

	"permissions": [
		"storage",
		"tabs",
		"webNavigation",
		"scripting",
		"alarms",
		"declarativeNetRequestWithHostAccess"
	],

	"host_permissions": [
		"<all_urls>"
	],

	"background": {
		"service_worker": "background/worker.js"
	},

	"action": {
		"default_title": "User-Agent Switcher",
		"default_popup": "ui/popup/index.html",
		"default_icon": {
			"16":  "assets/icons/disabled-16.png",
			"32":  "assets/icons/disabled-32.png",
			"48":  "assets/icons/disabled-48.png",
			"128": "assets/icons/disabled-128.png"
		}
	},

	"options_ui": {
		"page": "ui/options/index.html",
		"open_in_tab": true
	}
}
