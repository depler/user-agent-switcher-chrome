{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "typecheck",
			"type": "shell",
			"command": "npm run typecheck",
			"group": "test",
			"problemMatcher": "$tsc"
		},

		{
			"label": "lint",
			"type": "shell",
			"command": "npm run lint",
			"problemMatcher": ["$eslint-stylish"]
		},

		{
			"label": "test",
			"type": "shell",
			"command": "npm test",
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},

		{
			"label": "build",
			"type": "shell",
			"command": "npm run build",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},

		{
			"label": "icons",
			"type": "shell",
			"command": "npm run icons"
		}
	]
}
